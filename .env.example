# Base de données (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/sycebnl_suite?schema=public"

# JWT auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# Licence · AUCUNE variable ici (audit final F264). En ligne, la licence d'un
# dossier est une ligne de la base (table `licences`, lue par LicenceService) ;
# sur site, c'est un fichier signé par VMG et vérifié sans internet contre la
# clé publique écrite dans le code (src/modules/sur-site/cle-publique-editeur.ts),
# jamais lue dans l'environnement. Les deux variables de « vérification
# périodique » que ce fichier présentait n'étaient lues par aucun code : le
# heartbeat n'a pas été retenu (2026-09-26), et la tolérance hors ligne de
# l'ancienne règle vit en base (`Licence.joursGraceHorsLigne`).

# Compte d'envoi des courriels (module courrier) · TOUTES FACULTATIVES.
#
# Aucune n'est exigée au démarrage, et c'est voulu : sans elles, OmegaX écrit
# ses messages, les marque SANS_TRANSPORT et le dit à l'écran. Il ne prétend
# pas avoir envoyé, et ne perd rien · le jour où ces valeurs sont posées, les
# messages en attente repartent tels quels.
#
# C'est TOUT OU RIEN : les cinq premières sont nécessaires ensemble, une seule
# manquante et il n'y a pas de transport du tout, plutôt qu'un transport à
# moitié posé qui échouerait à la première connexion.
#
# En production, elles passent par les secrets du dépôt (API_SMTP_*) et par
# `deploy-cloud-run.yml`, JAMAIS par la console Google · `--env-vars-file`
# remplace toutes les variables du service à chaque déploiement.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="courrier@example.com"
SMTP_PASS="<mot-de-passe>"
COURRIER_EXPEDITEUR="OmegaX <courrier@example.com>"
# Facultative · déduite du port quand elle est absente (465 = chiffré dès
# l'ouverture). Refusée si sa valeur ne se lit ni comme vrai ni comme faux.
SMTP_SECURE="false"
