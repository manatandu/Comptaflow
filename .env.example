# Base de données (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/sycebnl_suite?schema=public"

# JWT auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# Licence · vérification périodique (heartbeat), y compris en mode on-premise
LICENCE_CHECK_URL="https://licence.example.com/verify"
LICENCE_GRACE_PERIOD_DAYS="7"
