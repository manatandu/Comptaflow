{
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ecc-hooks/hooks/ecc-statusline.js\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ecc-hooks/hooks/block-no-verify.js\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ecc-hooks/hooks/config-protection.js\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ecc-hooks/hooks/ecc-metrics-bridge.js\"", "timeout": 10 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ecc-hooks/hooks/ecc-context-monitor.js\"", "timeout": 10 }
        ]
      }
    ]
  }
}
