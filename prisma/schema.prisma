// Schéma Phase 0 — fondations multi-tenant + licence + moteur comptable SYCEBNL.
// Le plan de comptes SYSCOHADA (entreprises) sera ajouté en Phase 3 en réutilisant
// les mêmes modèles Compte / Ecriture / LigneEcriture / Exercice (le référentiel
// est porté par Tenant.referentiel, pas par un schéma séparé).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant & licence
// ---------------------------------------------------------------------------

enum Referentiel {
  SYCEBNL // associations, ONG, projets de développement (MVP)
  SYSCOHADA // entreprises (Phase 3)
}

enum TypeLicence {
  ABONNEMENT // coupure automatique à échéance
  PERPETUEL_SAAS // payé une fois, hébergé chez nous, sans expiration
  PERPETUEL_ONPREMISE // payé une fois, installé chez le client (Phase 4)
}

enum StatutLicence {
  ACTIVE
  EXPIREE
  SUSPENDUE
}

model Tenant {
  id          String      @id @default(uuid())
  nom         String
  referentiel Referentiel @default(SYCEBNL)
  createdAt   DateTime    @default(now())

  // Coordonnées — collectées par l'assistant « Nouveau fichier comptable »,
  // toutes optionnelles pour ne pas bloquer une inscription rapide.
  activite  String?
  adresse   String?
  ville     String?
  pays      String? @default("RD Congo")
  telephone String?
  devise    String? @default("CDF")

  licence          Licence?
  comptes          Compte[]
  exercices        Exercice[]
  ecritures        Ecriture[]
  users            User[]
  journaux         Journal[]
  clotures         Cloture[]
  tiers            Tiers[]
  modelesReglement ModeleReglement[]
  tauxTva          TauxTva[]

  @@map("tenants")
}

// Une licence par tenant. Le champ dateExpiration est nul pour les deux formes
// perpétuelles ; c'est dateExpiration + statut qui pilotent la coupure automatique
// pour un abonnement (voir LicenceGuard).
model Licence {
  id                  String        @id @default(uuid())
  tenantId            String        @unique
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  type                TypeLicence
  statut              StatutLicence @default(ACTIVE)
  dateDebut           DateTime      @default(now())
  dateExpiration      DateTime? // null pour PERPETUEL_SAAS / PERPETUEL_ONPREMISE
  dernierHeartbeatAt  DateTime? // pour PERPETUEL_ONPREMISE : dernière vérification en ligne réussie
  joursGraceHorsLigne Int           @default(7) // tolérance hors-ligne avant coupure (on-premise)

  @@map("licences")
}

enum RoleUtilisateur {
  ADMIN_CABINET
  COMPTABLE
  LECTURE_SEULE
}

model User {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  email      String          @unique
  motDePasse String
  role       RoleUtilisateur @default(COMPTABLE)
  // Désactivé plutôt que supprimé : un utilisateur peut être créateur
  // d'écritures (createdBy) — le supprimer casserait la piste d'audit.
  estActif   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  @@map("users")
}

// ---------------------------------------------------------------------------
// Moteur comptable — partie double
// ---------------------------------------------------------------------------

enum ClasseCompte {
  CLASSE_1 // Fonds propres et ressources durables
  CLASSE_2 // Immobilisations
  CLASSE_3 // Stocks
  CLASSE_4 // Tiers
  CLASSE_5 // Trésorerie
  CLASSE_6 // Charges
  CLASSE_7 // Produits
  CLASSE_8 // Autres charges/produits
  CLASSE_9 // Comptabilité analytique / engagements
}

// Report à-nouveau — 3 modes par compte (cf. docs/plan-de-construction.md §3.1) :
// - AUCUN : pas de report, soldé sur le résultat (comptes de charges/produits,
//   classes 6/7 — voir ExerciceService.cloturer, qui les vire vers le compte
//   de résultat plutôt que de les reporter).
// - SOLDE : seul le solde net est reporté (comptes de bilan génériques).
// - DETAIL : chaque mouvement NON LETTRÉ est reporté individuellement (comptes
//   nécessitant un suivi fin, ex. tiers) — suppose un lettrage à jour.
enum ModeReportANouveau {
  AUCUN
  SOLDE
  DETAIL
}

// Comptes "Total"/regroupement par racine (§3.1, §3.5 — brique technique qui
// prépare le futur moteur de mapping/états financiers) : un compte Total ne
// reçoit JAMAIS d'écriture directement (voir EcritureService.creer) ; son
// solde est calculé en agrégeant tous les comptes Détail dont le numéro
// commence par le sien (voir EcritureService.balance) — pas une relation
// explicite parent/enfant, un simple préfixe numérique, comme chez Sage.
// Préfixe au sens LITTÉRAL de la chaîne de caractères, sans troncature des
// zéros de fin : la racine "411" agrège "411001"/"411002", mais "411000" ne
// les agrège PAS (le numéro complet du Total n'est alors plus un préfixe de
// celui du Détail) — un piège relevé en testant la fonctionnalité, à choisir
// la racine en conséquence (numéro court, pas un numéro complet suffixé de
// zéros).
enum TypeCompteDetailTotal {
  DETAIL
  TOTAL
}

model Compte {
  id                 String                @id @default(uuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  numero             String // ex : "10600" fonds associatif, "1810" fonds affecté
  intitule           String
  classe             ClasseCompte
  typeCompte         TypeCompteDetailTotal @default(DETAIL)
  estActif           Boolean               @default(true)
  modeReportANouveau ModeReportANouveau    @default(SOLDE)

  lignesEcriture     LigneEcriture[]
  journauxTresorerie Journal[] // journaux de type TRESORERIE dont ce compte est la contrepartie
  // Rattachement à un tiers (cf. §3.2) : au plus un tiers par compte — un
  // compte de classe 4 est le sous-compte auxiliaire d'un seul tiers.
  tiersCompte        TiersCompte?
  // Comptes d'État TVA (443/445) référencés par un ou plusieurs taux (§3.1) —
  // un même compte 443100 peut être partagé par plusieurs taux (16 %, 1 %...).
  tauxTvaCollecte    TauxTva[]       @relation("TauxTvaCollecte")
  tauxTvaDeductible  TauxTva[]       @relation("TauxTvaDeductible")

  @@unique([tenantId, numero])
  @@map("comptes")
}

// ---------------------------------------------------------------------------
// Journaux — entité de premier ordre (fondation, cf. docs/plan-de-construction.md §3.1)
// ---------------------------------------------------------------------------

enum TypeJournal {
  ACHATS
  VENTES
  TRESORERIE
  GENERAL
  SITUATION // jamais clôturé ni compacté — écritures provisoires/simulation
}

enum NumerotationPiece {
  MANUELLE // saisie libre du numéro de pièce (non auto-généré)
  CONTINUE_JOURNAL // incrémenté par journal, sur l'exercice
  CONTINUE_FICHIER // incrémenté tous journaux confondus, sur l'exercice
  MENSUELLE // incrémenté par journal, remis à zéro chaque mois
}

model Journal {
  id       String      @id @default(uuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  code     String // ex : "ACH", "VEN", "BQ", "CA", "OD"
  intitule String
  type     TypeJournal

  // Obligatoire si type = TRESORERIE (compte sur lequel la contrepartie est
  // automatiquement enregistrée) ; sans objet pour ACHATS/VENTES/SITUATION.
  compteTresorerieId String?
  compteTresorerie   Compte? @relation(fields: [compteTresorerieId], references: [id])

  numerotation NumerotationPiece @default(MANUELLE)
  estActif     Boolean           @default(true) // "mise en sommeil" réversible
  createdAt    DateTime          @default(now())

  ecritures Ecriture[]
  clotures  Cloture[]

  @@unique([tenantId, code])
  @@map("journaux")
}

enum StatutExercice {
  OUVERT
  CLOTURE
}

model Exercice {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  dateDebut DateTime
  dateFin   DateTime
  statut    StatutExercice @default(OUVERT)

  ecritures Ecriture[]
  clotures  Cloture[]

  @@unique([tenantId, dateDebut, dateFin])
  @@map("exercices")
}

// Une écriture = un fait comptable, composé d'au moins 2 lignes équilibrées
// (total débit = total crédit). L'équilibre est vérifié en service, pas en DB.
model Ecriture {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  exerciceId  String
  exercice    Exercice @relation(fields: [exerciceId], references: [id])
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id])
  // Numéro de pièce auto-calculé selon Journal.numerotation (null si
  // NumerotationPiece.MANUELLE — voir JournalService.prochainNumeroPiece).
  numeroPiece Int?
  date        DateTime
  libelle     String
  reference   String? // pièce justificative (numéro de facture, référence externe...)
  createdAt   DateTime @default(now())
  createdBy   String // piste d'audit : jamais modifiable après clôture de l'exercice

  // Écriture générée automatiquement par la clôture de l'exercice (clôture des
  // classes 6/7 sur le résultat, ou report à-nouveau dans l'exercice suivant) —
  // voir ExerciceService.cloturer. Purement informatif pour l'instant (affichage),
  // ces écritures sont de toute façon déjà protégées comme les autres par le
  // statut CLOTURE de leur exercice.
  estGenereeParCloture Boolean @default(false)

  lignes LigneEcriture[]

  @@map("ecritures")
}

// ---------------------------------------------------------------------------
// Clôture — 3 granularités (cf. docs/plan-de-construction.md §3.1) :
// - PARTIELLE : verrouille les écritures d'un journal jusqu'à dateLimite,
//   réversible (annulable = true) ; nouvelles saisies encore possibles après
//   dateLimite dans ce même journal.
// - TOTALE : fige un journal en entier (dateLimite = dateFin de l'exercice le
//   plus souvent), définitive.
// - PERIODE : verrouille jusqu'à dateLimite, tous journaux confondus
//   (journalId = null), définitive.
// Distincte de la clôture annuelle de l'exercice (ExerciceService.cloturer,
// StatutExercice.CLOTURE) qui, elle, génère le report à-nouveau réel.
// ---------------------------------------------------------------------------

enum GranulariteCloture {
  PARTIELLE
  TOTALE
  PERIODE
}

model Cloture {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  exerciceId  String
  exercice    Exercice           @relation(fields: [exerciceId], references: [id])
  granularite GranulariteCloture
  // Requis pour PARTIELLE/TOTALE (verrouille ce seul journal) ; null pour
  // PERIODE (verrouille tous les journaux du tenant jusqu'à dateLimite).
  journalId   String?
  journal     Journal?           @relation(fields: [journalId], references: [id])
  dateLimite  DateTime
  annulable   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  createdBy   String
  annuleeAt   DateTime?
  annuleeBy   String?

  @@map("clotures")
}

model LigneEcriture {
  id         String   @id @default(uuid())
  ecritureId String
  ecriture   Ecriture @relation(fields: [ecritureId], references: [id])
  compteId   String
  compte     Compte   @relation(fields: [compteId], references: [id])
  libelle    String?
  debit      Decimal  @default(0) @db.Decimal(18, 2)
  credit     Decimal  @default(0) @db.Decimal(18, 2)

  // Lettrage — rapprochement débit/crédit sur un compte (cf.
  // docs/plan-de-construction.md §3.1). Toutes les lignes d'un même
  // rapprochement partagent la même lettre (A, B, ..., Z, AA, AB, ...,
  // générée par compte — voir LettrageService.prochaineLettre) ; null tant
  // que la ligne n'est pas lettrée. Le lettrage est un prérequis du report
  // à-nouveau "Détail" et de toute gestion sérieuse des tiers.
  lettre String?

  // Taux de TVA appliqué à CETTE ligne (la ligne de TVA elle-même, pas la
  // ligne HT) — posé par la saisie guidée "Achat/Vente avec TVA" de
  // SaisiePage. Sert au registre/déclaration TVA (TauxTvaService.
  // declaration) : somme des lignes créditées sur le compte de collecte du
  // taux moins somme des lignes débitées sur son compte de déduction, sur
  // une période. Null pour toute ligne hors TVA (l'immense majorité).
  tauxTvaId String?
  tauxTva   TauxTva? @relation(fields: [tauxTvaId], references: [id])

  @@index([compteId, lettre])
  @@map("lignes_ecriture")
}

// ---------------------------------------------------------------------------
// Tiers (cf. docs/plan-de-construction.md §3.2) — dépend du Lettrage (déjà
// livré) : le rapprochement débit/crédit par compte est le mécanisme qui rend
// utile le suivi par tiers (solde réel = mouvements non lettrés).
// ---------------------------------------------------------------------------

enum TypeTiers {
  CLIENT
  FOURNISSEUR
  SALARIE
  AUTRE
}

// Condition de calcul de l'échéance : NET = dateFacture + délaiJours ;
// FIN_DE_MOIS = fin du mois de la facture + délaiJours (ex. "30 jours fin de
// mois", très répandu en zone OHADA).
enum ConditionEcheance {
  NET
  FIN_DE_MOIS
}

// Fractionnement en plusieurs échéances (pattern Sage : type pourcentage/
// équilibre/montant + délai + condition par échéance). POURCENTAGE = X % du
// montant total ; MONTANT = un montant fixe ; EQUILIBRE = absorbe le reste
// (solde après les échéances précédentes) — typiquement la dernière ligne,
// pour garantir que la somme retombe exactement sur le montant total malgré
// les arrondis des pourcentages.
enum TypeEcheance {
  POURCENTAGE
  MONTANT
  EQUILIBRE
}

model ModeleReglement {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  intitule   String // ex : "30 jours net", "60 jours fin de mois"
  // Échéance unique par défaut (100 % du montant à delaiJours/echeance) —
  // c'est le mode mono-échéance du MVP initial, toujours valable tel quel
  // tant qu'aucune ligne n'existe dans `echeances` (voir TauxTvaService...
  // pardon, TiersService.calculerEcheances : `echeances` vide → une seule
  // échéance construite à partir de ces deux champs, sinon `echeances` fait
  // foi et ces deux-là ne servent plus qu'à l'affichage résumé de la liste).
  delaiJours Int
  echeance   ConditionEcheance @default(NET)
  estActif   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  tiers     Tiers[]
  echeances EcheanceReglement[]

  @@unique([tenantId, intitule])
  @@map("modeles_reglement")
}

// Une ligne d'échéance d'un modèle fractionné. Le tenant n'en crée que s'il
// a besoin de plusieurs échéances ; un modèle sans aucune ligne ici reste
// mono-échéance (voir le commentaire sur ModeleReglement.delaiJours).
model EcheanceReglement {
  id                String            @id @default(uuid())
  modeleReglementId String
  modeleReglement   ModeleReglement   @relation(fields: [modeleReglementId], references: [id])
  ordre             Int // ordre d'application — détermine aussi ce que "le reste" signifie pour EQUILIBRE
  type              TypeEcheance
  // Pourcentage (0-100) pour POURCENTAGE, montant fixe pour MONTANT, null
  // pour EQUILIBRE (n'a pas de valeur propre, prend ce qu'il reste).
  valeur            Decimal?          @db.Decimal(12, 2)
  delaiJours        Int
  echeance          ConditionEcheance @default(NET)

  @@unique([modeleReglementId, ordre])
  @@map("echeances_reglement")
}

model Tiers {
  id       String    @id @default(uuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  type     TypeTiers
  code     String // ex : "CLI-0001" — libre, unique par tenant
  nom      String
  estActif Boolean   @default(true)

  modeleReglementId String?
  modeleReglement   ModeleReglement? @relation(fields: [modeleReglementId], references: [id])

  createdAt DateTime @default(now())

  comptesRattaches TiersCompte[]

  @@unique([tenantId, code])
  @@map("tiers")
}

// Comptes généraux rattachés à un tiers (§3.2 : "sous-compte auxiliaire
// remonté sur un compte collectif" — un compte donné n'est rattaché qu'à un
// seul tiers, cf. Compte.tiersCompte). Un seul compte marqué Principal par
// tiers ; imposé par TiersService.rattacherCompte, pas par une contrainte SQL
// (Postgres ne supporte pas nativement un "unique partiel" via Prisma ici).
model TiersCompte {
  id           String   @id @default(uuid())
  tiersId      String
  tiers        Tiers    @relation(fields: [tiersId], references: [id])
  compteId     String   @unique
  compte       Compte   @relation(fields: [compteId], references: [id])
  estPrincipal Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("tiers_comptes")
}

// ---------------------------------------------------------------------------
// TVA (cf. docs/plan-de-construction.md §3.1 et §5) — entité "Taux" paramétrable
// (pattern Sage : compte + comptes rattachés par taux), fondée sur
// l'Ordonnance-Loi n° 10/001 du 20/08/2010 telle que modifiée par la Loi de
// Finances 2026 (art. 35 O.-L., modifié par l'art. 46 LF n° 25/060 du
// 29/12/2025) : taux normal 16 %, taux réduits 1 % et 5 % (5 % réservé aux
// seuls billets d'avion sur le trafic aérien national), taux zéro 0 %
// (exportations). Les exonérations légales (art. 15.2 et 17.8 : ventes,
// importations et prestations des ASBL conformes à leur objet, sous réserve
// de non-distorsion de concurrence pour les prestations) ne sont PAS un taux
// à 0 % — une opération exonérée ne porte aucune ligne de TVA, elle n'utilise
// donc simplement aucun taux ; seed volontairement sans taux "EXONÉRÉ" pour
// ne pas laisser croire à une automatisation qui n'existe pas encore.
//
// Application à la saisie : deux types d'opération guidée dans SaisiePage
// ("Achat avec TVA" / "Vente avec TVA") calculent HT→TVA→TTC et posent une
// 3ᵉ ligne sur le compte de collecte/déduction du taux choisi, taguée
// LigneEcriture.tauxTvaId. TauxTvaService.declaration() additionne ces
// lignes par taux sur une période et applique le prorata de déduction
// (art. 43-49 O.-L. — prorata général, sans option secteurs distincts) à la
// TVA déductible brute. TauxTvaService.comptabiliserLiquidation() pose
// l'écriture de liquidation (solde 443/445 admis sur le compte 444) via
// EcritureService.creer(), donc avec les mêmes contrôles que toute saisie.
// Toujours hors scope : la régularisation pluriannuelle du prorata sur les
// immobilisations (art. 46), l'option secteurs distincts (art. 49), et la
// saisie libre multi-lignes générale (SaisiePage reste une saisie guidée,
// pas un éditeur d'écriture quelconque).
// ---------------------------------------------------------------------------

model TauxTva {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String // ex : "TVA16", "TVA1", "TVA5", "TVA0"
  intitule String
  // Pourcentage (ex. 16.00) ; 0 pour le taux zéro (exportations).
  taux     Decimal @db.Decimal(5, 2)

  // Compte 443 (État, TVA facturée) crédité lors d'une vente à ce taux.
  compteCollecteId   String?
  compteCollecte     Compte? @relation("TauxTvaCollecte", fields: [compteCollecteId], references: [id])
  // Compte 445 (État, TVA récupérable) débité lors d'un achat à ce taux.
  compteDeductibleId String?
  compteDeductible   Compte? @relation("TauxTvaDeductible", fields: [compteDeductibleId], references: [id])

  estActif  Boolean  @default(true)
  createdAt DateTime @default(now())

  lignesEcriture LigneEcriture[]

  @@unique([tenantId, code])
  @@map("taux_tva")
}
